# Local docker: bolt://localhost:7687 / neo4j / repomemory
# AuraDB: paste from the credentials file you downloaded when creating the instance
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Where repos get cloned. Relative paths are resolved from the repomemory/ folder.
WORKSPACE_DIR=./workspace
# Cheap model used once at ingestion to classify commits
KNOWLEDGE_MODEL=groq/openai/gpt-oss-120b
